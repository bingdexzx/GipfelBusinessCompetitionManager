{
  "name": "gipfel-business-competition-manager-client",
  "version": "1.0.0",
  "description": "商赛办赛辅助系统 - 客户端",
  "author": "Gipfel",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "electron:dev": "vite",
    "electron:build": "vite build && electron-builder",
    "electron:preview": "vite build && electron .",
    "lint": "eslint \"src/**/*.{ts,vue}\" --fix",
    "lint:check": "eslint \"src/**/*.{ts,vue}\"",
    "format": "prettier --write \"src/**/*.{ts,vue}\""
  },
  "dependencies": {
    "axios": "^1.7.2",
    "echarts": "^5.5.1",
    "element-plus": "^2.7.6",
    "konva": "^9.3.11",
    "pinia": "^2.1.7",
    "socket.io-client": "^4.7.5",
    "vue": "^3.4.29",
    "vue-echarts": "^7.0.3",
    "vue-konva": "^3.0.2",
    "vue-router": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "@vitejs/plugin-vue": "^5.0.5",
    "electron": "^30.1.0",
    "electron-builder": "^24.13.3",
    "sass": "^1.77.6",
    "typescript": "^5.5.2",
    "vite": "^5.3.1",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vue-tsc": "^2.0.22",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-vue": "^9.27.0",
    "prettier": "^3.3.3",
    "vue-eslint-parser": "^9.4.3"
  },
  "build": {
    "appId": "gipfel.businesscompetitionmanager",
    "productName": "Gipfel商赛系统",
    "artifactName": "Gipfel商赛系统 Setup ${version}.${ext}",
    "icon": "build/icon.ico",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
