# ============================================================
# Gipfel 商赛系统 — 服务端环境变量配置
# 复制本文件为 .env 并按需修改：cp .env.example .env
# 详见 docs/软件文档.md §3.3
# ============================================================

# 服务端监听端口（默认 3000）
PORT=3000

# SQLite 数据库文件路径（相对 server/prisma/，通常无需修改）
DATABASE_URL="file:./dev.db"

# 【必填】JWT 签名密钥 —— 未配置时服务端直接拒绝启动
# 生产环境必须改为强随机值，如：openssl rand -hex 32
JWT_SECRET="your-dev-secret-change-in-production"

# 默认管理员密码（仅首次启动/种子写入时使用，之后通过「强制改密」流程修改）
# 未设置时回退为 "admin123"（仅限开发环境）
# SEED_ADMIN_PASSWORD="your-strong-password"

# JWT 有效期（默认 24h，支持 ms 库格式：1h / 7d / 30m）
JWT_EXPIRES_IN="24h"

# JWT 签发者声明（默认 gipfel-competition）
JWT_ISSUER="gipfel-competition"

# JWT 受众声明（默认 gipfel-competition-client）
JWT_AUDIENCE="gipfel-competition-client"

# 日志级别：error / warn / info / debug（默认 info）
LOG_LEVEL="info"

# 日志文件输出目录（相对 server/，默认 ./logs）
LOG_DIR="./logs"

# CORS 允许的来源（可选）
# 未设置：仅允许本地/私网来源（localhost、RFC1918、file://、app://）
# 设为具体域名（逗号分隔）：严格白名单
# 设为 *：同「未设置」行为（不放行公网）
# CORS_ORIGIN="https://your-domain.com"
