generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ========== 枚举值定义（注释形式） ==========
// 由于 SQLite 不支持原生 enum，使用 String + 注释定义合法值
// UserRole: SUPER_ADMIN | COMPETITION_ADMIN | PLAYER
// ContractStatus: DRAFT | EXECUTED | TERMINATED
// OrderSide: BUY | SELL
// OrderStatus: PENDING | FILLED | CANCELLED
// FiscalYearStatus: ACTIVE | CLOSED

model User {
  id            Int         @id @default(autoincrement())
  username      String      @unique
  passwordHash  String
  role          String      @default("PLAYER") // SUPER_ADMIN | COMPETITION_ADMIN | PLAYER
  displayName   String?
  competitionId Int?
  competition   Competition? @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  // 细粒度权限：JSON 数组，存放权限 key（如 ["data:material:edit","contract:execute"]）。
  // 为 null 表示仅按 role 继承；SUPER_ADMIN 始终隐式拥有全部权限，不受此字段约束。
  permissions   String?
  // 公司审核范围：JSON 数组，存放该账号可作为管理员/审核员审核其合同的公司 id。
  // 仅在与 contract:audit 权限配合时生效；为 null 表示无范围限制（通常仅超管/合同管理员用到）。
  companyScopes String?
  // 公司可见字段范围（company:view 专属）：JSON 数组，存放该账号可读取「全量（含未发布）字段」的公司 id。
  // 仅在与 company:view 权限配合时生效；为 null 表示无范围限制（全部公司全量可读）。
  // 与 companyScopes（contract:audit 审核范围）相互独立，分别控制「读」与「审」两类范围。
  viewCompanyScopes String?
  // 合同查看范围（contract:view 专属）：JSON 数组，存放该账号可查看的合同的参与方公司 id。
  // 仅在与 contract:view 配合时生效（且不影响 contract:audit/execute/manage 等更高权限）；
  // 为 null 表示无范围限制（可见全部合同）。与 companyScopes / viewCompanyScopes 相互独立。
  contractViewCompanyScopes String?
  // 股票系统管理范围（stock:edit 低级管理专属）：JSON 数组，存放该账号可管理的「公司」id。
  // 仅在与 stock:edit 配合时生效；为 null 表示无范围限制（通常仅超管/高级管理用到）。
  // 低级管理据此只能管理：上述公司名下的资金账户 + 自己的用户资金账户；高级管理(stock:manage)不受限。
  stockCompanyScopes String?
  // 强制改密标志：种子默认超管置 true，登录后未改密前禁止访问业务接口（安全加固）。
  mustChangePassword Boolean @default(false)
  // 单设备登录：每次登录自增，作为 JWT 内的「会话版本号」。
  // 库内当前 tokenVersion 与 token 内携带的不一致即判定该 token 失效（被新设备登录顶掉）。
  tokenVersion Int          @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model FiscalYear {
  id            Int         @id @default(autoincrement())
  competitionId Int
  year          Int
  status        String      @default("ACTIVE") // ACTIVE | CLOSED
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([competitionId, year])
}

model Competition {
  id              Int                @id @default(autoincrement())
  name            String             @unique
  status          String             @default("ACTIVE") // ACTIVE, ARCHIVED
  fiscalYears     FiscalYear[]
  users           User[]
  companies       Company[]
  regions         Region[]
  consumerDemands ConsumerDemand[]
  materials       Material[]
  parts           Part[]
  products        Product[]
  techNodes       TechNode[]
  mapNodeTypes    MapNodeType[]
  pathTypes       PathType[]
  mapNodes        MapNode[]
  mapEdges        MapEdge[]
  infrastructures Infrastructure[]
  fuels           Fuel[]
  vehicles        Vehicle[]
  warehouses      Warehouse[]
  productionLines ProductionLine[]
  contracts       Contract[]
  // 股票系统
  stocks                Stock[]
  stockFundsAccounts    StockFundsAccount[]
  stockOrders           StockOrder[]
  stockHoldings         StockHolding[]
  stockCandles          StockCandle[]
  // 地图背景图（每比赛一张）：JSON 字符串 { url, filename, width, height }，null 表示未设置。
  // 由管理端「地图管理」上传，作为整张地图编辑器的背景图层（覆盖节点包围盒、不影响节点/边坐标）。
  mapBackground   String?
  // 股票系统全局配置（JSON）：比赛级 stockConfig（S8），null = 使用 DEFAULT_STOCK_CONFIG
  stockConfig     Json?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model Material {
  id                        Int            @id @default(autoincrement())
  name                      String
  origin                    String
  carbonEmissionCoefficient Float
  // 按地点（地图节点）价格：JSON 字符串 { [mapNodeId]: 价格 }。
  // 原料价格完全按地点（节点）定价，无基础价格字段。
  // 计算原料总价格时按参与方所在节点取对应价，未设地点价的节点按 0 计。
  nodePrices               String   @default("{}")
  type                      String   @default("NORMAL") // NORMAL, SPECIAL
  competitionId             Int?
  competition               Competition?   @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  partMaterials             PartMaterial[]
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  @@unique([competitionId, name])
}

model Part {
  id               Int                     @id @default(autoincrement())
  name             String
  competitionId    Int?
  competition      Competition?            @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  partMaterials    PartMaterial[]
  productParts     ProductPart[]
  techRequirements PartTechRequirement[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@unique([competitionId, name])
}

model PartMaterial {
  partId     Int
  materialId Int
  ratio      Float
  part       Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@id([partId, materialId])
}

model PartTechRequirement {
  partId     Int
  techNodeId Int
  part       Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  techNode   TechNode @relation(fields: [techNodeId], references: [id], onDelete: Cascade)

  @@id([partId, techNodeId])
}

model Product {
  id               Int                        @id @default(autoincrement())
  name             String
  competitionId    Int?
  competition      Competition?            @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  productParts     ProductPart[]
  techRequirements ProductTechRequirement[]
  consumerDemands  ConsumerDemand[]
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  @@unique([competitionId, name])
}

model ProductPart {
  productId Int
  partId    Int
  ratio     Float
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  part      Part    @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@id([productId, partId])
}

model ProductTechRequirement {
  productId  Int
  techNodeId Int
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  techNode   TechNode @relation(fields: [techNodeId], references: [id], onDelete: Cascade)

  @@id([productId, techNodeId])
}

model TechNode {
  id                   Int                        @id @default(autoincrement())
  name                 String
  description          String?
  tier                 Int                        @default(0)
  researchCost         Float                      @default(0)
  competitionId    Int?
  competition      Competition?            @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  prerequisites        TechPrerequisite[]         @relation("NodePrerequisites")
  requiredBy           TechPrerequisite[]         @relation("NodeRequiredBy")
  partRequirements     PartTechRequirement[]
  productRequirements  ProductTechRequirement[]
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  @@unique([competitionId, name])
}

model TechPrerequisite {
  nodeId             Int
  prerequisiteNodeId Int
  node               TechNode @relation("NodePrerequisites", fields: [nodeId], references: [id], onDelete: Cascade)
  prerequisite       TechNode @relation("NodeRequiredBy", fields: [prerequisiteNodeId], references: [id], onDelete: Cascade)

  @@id([nodeId, prerequisiteNodeId])
}

model MapNodeType {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  color       String?
  competitionId    Int?
  competition      Competition?            @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  nodes       MapNode[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([competitionId, name])
}

model PathType {
  id          Int               @id @default(autoincrement())
  name        String
  description String?
  color       String?
  competitionId    Int?
  competition      Competition?            @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  edges       MapEdge[]
  vehicles    VehiclePathType[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([competitionId, name])
}

model MapNode {
  id         Int         @id @default(autoincrement())
  name       String
  region     String
  nodeTypeId Int
  x          Float       @default(0)
  y          Float       @default(0)
  competitionId    Int?
  competition      Competition?            @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  nodeType   MapNodeType @relation(fields: [nodeTypeId], references: [id], onDelete: Cascade)
  edgesFrom  MapEdge[]   @relation("EdgeFrom")
  edgesTo    MapEdge[]   @relation("EdgeTo")
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([competitionId, name])
}

model MapEdge {
  id         Int      @id @default(autoincrement())
  fromNodeId Int
  toNodeId   Int
  distance   Float
  pathTypeId Int
  competitionId    Int?
  competition      Competition?            @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  fromNode   MapNode  @relation("EdgeFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode     MapNode  @relation("EdgeTo", fields: [toNodeId], references: [id], onDelete: Cascade)
  pathType   PathType @relation(fields: [pathTypeId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([fromNodeId, toNodeId])
}

model Infrastructure {
  id                         Int      @id @default(autoincrement())
  name                       String
  footprint                  Float
  employmentRateBonus        Float    @default(0)
  populationBonus            Float    @default(0)
  highQualityPopulationBonus Float    @default(0)
  price                      Float
  happinessIndexBonus        Float    @default(0)
  perCapitaIncomeBonus       Float    @default(0)
  carbonReductionBonus       Float    @default(0)
  activationPrice            Float
  competitionId    Int?
  competition      Competition?            @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@unique([competitionId, name])
}

model Warehouse {
  id       Int      @id @default(autoincrement())
  name     String
  capacity Float
  price    Float
  type     String   // MATERIAL, PART, PRODUCT
  competitionId    Int?
  competition      Competition?            @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([competitionId, name])
}

model ProductionLine {
  id         Int      @id @default(autoincrement())
  name       String
  price      Float
  laborCount Int
  maxPerYear Float
  competitionId    Int?
  competition      Competition?            @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([competitionId, name])
}

model Fuel {
  id            Int       @id @default(autoincrement())
  name          String
  pricePerLiter Float
  competitionId    Int?
  competition      Competition?            @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  vehicles      Vehicle[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([competitionId, name])
}

model Vehicle {
  id                   Int               @id @default(autoincrement())
  name                 String
  fuelId               Int
  fuelConsumptionPerKm Float
  maxCargo             Float
  price                Float
  carbonEmission       Float
  competitionId    Int?
  competition      Competition?            @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  fuel                 Fuel              @relation(fields: [fuelId], references: [id])
  vehiclePathTypes     VehiclePathType[]
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@unique([competitionId, name])
}

model VehiclePathType {
  vehicleId  Int
  pathTypeId Int
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  pathType   PathType @relation(fields: [pathTypeId], references: [id], onDelete: Cascade)

  @@id([vehicleId, pathTypeId])
}

// ============ 产业类型 ============
model IndustryType {
  id          Int             @id @default(autoincrement())
  name        String
  code        Int             @unique
  description String?
  icon        String?
  fields      IndustryField[]
  companies   Company[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model IndustryField {
  id             Int                  @id @default(autoincrement())
  industryTypeId Int
  name           String
  fieldKey       String
  // 字段类型：STRING / NUMBER / BOOLEAN / DICTIONARY / LIST
  // - DICTIONARY：键值字典，config 定义 entries（key/label/defaultValue）与 valueType
  // - LIST：列表，config 定义 itemType（STRING/NUMBER/BOOLEAN）
  fieldType      String               @default("NUMBER")
  // 类型相关配置（JSON 字符串）：DICTIONARY -> { entries:[{key,label,defaultValue}], valueType }
  // LIST -> { itemType }。其它类型可为空对象。
  config         String               @default("{}")
  defaultValue   String?
  isCalculated   Boolean              @default(false)
  calcGraph      String?              // 产业计算图（GGraph JSON）：isCalculated=true 时由该图在写入时级联重算本字段
  formula        String?              // 旧公式引擎，已废弃（保留列以兼容历史数据）
  sortOrder      Int                  @default(0)
  // 字段是否在前台展示：false 时该字段不出现在公司管理 / 区域总览字段选择 / 合同编辑器字段目标等任何客户端展示中；
  // 仅为展示层开关，合同引擎仍按 fieldKey 正常读写其 CompanyFieldValue。
  visible        Boolean              @default(true)
  // 财年定时器：启用后，于财年「开始(FY_START) / 结束(FY_END)」时自动把该字段写为 timerValue（按字段类型序列化）。
  // 定时器字段为普通字段，不可与计算字段(isCalculated)同时启用——计算字段写入后会被级联重算覆盖，定时器失去意义。
  // 触发由 FiscalYear.status 切换驱动：新建财年(默认 ACTIVE) 或 status 由非 ACTIVE→ACTIVE 视为 FY_START；
  // status 由非 CLOSED→CLOSED 视为 FY_END。作用范围：该产业类型的全部公司（按比赛收敛）。
  timerEnabled  Boolean              @default(false) // 是否启用财年定时器
  timerTrigger  String?              // 触发时机：FY_START（财年开始）/ FY_END（财年结束）
  timerValue    String?              // 触发后写入的设定值（按字段类型序列化前的原始字符串；DICTIONARY/LIST 为 JSON）
  industryType   IndustryType         @relation(fields: [industryTypeId], references: [id], onDelete: Cascade)
  fieldValues    CompanyFieldValue[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([industryTypeId, fieldKey])
}

// ============ 区域（业务分组，含总览卡片配置） ============
model Region {
  id             Int       @id @default(autoincrement())
  name           String
  description    String?
  // 区域为比赛级数据（无 competitionId 视为全局模板，通常不使用）；删除比赛级联删除其下区域
  competitionId  Int?
  competition    Competition? @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  // 总览卡片配置：JSON 字符串，元素结构见 README §9.11.2
  // [{ id, displayName, companyId, industryFieldId }]
  overviewCards  String    @default("[]")
  companies      Company[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([competitionId, name])
}

// ============ 消费者需求（按区域记录的产品需求） ============
model ConsumerDemand {
  id            Int       @id @default(autoincrement())
  // 比赛级数据，删除比赛时级联删除
  competitionId Int?
  competition   Competition? @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  region        String               // 区域名（对应地图区域）
  productId     Int?                 // 关联产品（产品主数据）；产品删除时置空不级联
  product       Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  productType   String               // 产品名称（冗余存储，便于产品删除后仍可读）
  quantity      Int      @default(0) // 产品数量
  note          String?              // 备注
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([competitionId, region])
}

// ============ 公司（产业实例） ============
model Company {
  id             Int                  @id @default(autoincrement())
  name           String
  industryTypeId Int?
  competitionId  Int?
  status         String               @default("ACTIVE")
  competition    Competition?         @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  industryType   IndustryType?        @relation(fields: [industryTypeId], references: [id])
  // 区域归属：一个公司仅属一个区域；删除区域时 regionId 置空（SetNull），不级联删公司
  regionId       Int?
  region         Region?              @relation(fields: [regionId], references: [id], onDelete: SetNull)
  fieldValues    CompanyFieldValue[]
  stocks         Stock[]              // 关联的上市股票（股票系统）
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
}

model CompanyFieldValue {
  id              Int            @id @default(autoincrement())
  companyId       Int
  industryFieldId Int
  value           String
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  industryField   IndustryField  @relation(fields: [industryFieldId], references: [id])
  updatedAt       DateTime       @updatedAt

  @@unique([companyId, industryFieldId])
}

// ============ 合同系统（新引擎：配置驱动，仅操作产业字段） ============
// ContractType：合同类型模板（配置）。effects 为效果定义数组，引擎按类型执行。
model ContractType {
  id           Int       @id @default(autoincrement())
  key          String    @unique // 唯一编码，如 LOAN / FUEL_PURCHASE / RND
  name         String
  description  String?
  partyCount   Int       @default(2) // 2 或 3
  partyRoles   String    // JSON: [{role:"A",label:"放款方",selectable:true,isHost:false}, ...]
  inputSchema  String    // JSON: [{key,label,type,required,default?,enum?}]
  effects      String    // JSON: 效果定义数组（见合同引擎文档）。仅支持 FIELD 效果。
  conditions   String    @default("[]") // JSON: 前置检查数组（FIELD_COMPARE / INDUSTRY_IS）
  graph        String?   // JSON: 可视化编辑器图结构（节点+连线+布局），可选
  schemaVersion Int      @default(1) // 配置 schema 版本号（用于读时兼容、写时升级）
  enabled      Boolean   @default(true)
  contracts    Contract[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Contract：合同实例。
model Contract {
  id              Int          @id @default(autoincrement())
  competitionId   Int
  contractTypeId  Int
  name            String
  status          String       @default("DRAFT") // DRAFT, EXECUTED, TERMINATED
  parties         String       // JSON: [{role:"A",companyId:5,isHost:false}, ...]
  inputs          String       @default("{}") // JSON: 已填写的输入参数
  executionLog    String?      // JSON: 执行审计日志
  executionResult String?      // JSON: 执行结果快照
  signedAt        DateTime?
  executedAt      DateTime?
  competition     Competition  @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  contractType    ContractType @relation(fields: [contractTypeId], references: [id])
  fieldEffects    ContractFieldEffect[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

// ContractFieldEffect：合同执行时对某产业字段造成的单次改写（叶子效果）的不可变记录。
// 用于合同删除时「复原字段修改但不影响后续合同」：删合同时按 executedAt 顺序重放其余已执行合同
// 的增量，从而精确撤销本合同的字段影响，且不动后续合同已落账的字段值。
model ContractFieldEffect {
  id              Int      @id @default(autoincrement())
  contractId      Int
  companyId       Int
  industryFieldId Int
  fieldKey        String
  fieldName       String
  op              String // ADD | SUB | SET（与合同引擎 FieldEffect.op 一致）
  valueRaw        String // JSON：本次写入的增量值（执行期实际 newValue）
  beforeRaw       String // JSON：写入前字段现值（即本合同中该字段的基线）
  afterRaw        String // JSON：写入后字段现值
  createdAt       DateTime @default(now())
  contract        Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([companyId, industryFieldId])
}

// ============ 消息中心 ============
// Message：一条播发给若干收件人的站内消息（公告 / 通知）。
// 收件人在发布时一次性结算为 MessageRecipient 行（支持「本比赛全体」或显式选人），
// 故收件箱与未读状态以 MessageRecipient 为准，与比赛隔离逻辑解耦，离线用户登录后也能看到。
model Message {
  id      Int      @id @default(autoincrement())
  title   String
  content String
  senderId Int
  // 归属比赛（上下文展示 + 选人默认范围）；super-admin 跨比赛发布时为指定比赛 id，未指定可为 null。
  // 仅作展示与选人范围，收件箱以 MessageRecipient 为准，不依赖此字段做租户隔离。
  competitionId Int?
  // 是否「全体（可选范围内用户）」：true 时收件人 = 所有可选用户（发布者同比赛 / 超管全部）。
  targetsAll    Boolean  @default(false)
  // 显式指定收件人用户 id（JSON 数组）；与 targetsAll 取并集后去重。
  targetUserIds String   @default("[]")
  // 消息附带的图片（JSON 数组，元素 { url, filename }）；url 为 /uploads/message-images/... 相对路径，落盘于 uploads/message-images/。
  // 删除消息时由服务端一并清理落盘文件。
  images        String?  @default("[]")
  recipients    MessageRecipient[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([competitionId])
  @@index([senderId])
}

// MessageRecipient：消息与收件人的关联（含已读状态）。发布时按解析后的收件人批量写入。
// 删除消息时级联删除其收件人记录。
model MessageRecipient {
  id        Int       @id @default(autoincrement())
  messageId Int
  userId    Int
  read      Boolean   @default(false)
  readAt    DateTime?
  message   Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([messageId, userId])
  @@index([userId])
}

// ============ 股票系统 ============
// 行情与交易按「轮次」推进：每轮玩家下单（BUY/SELL），高级管理点「下一轮」汇总订单→撮合→按 Excel 逻辑算新价并生成一根 K 线。
// Stock：一只股票（对应一只上市商赛公司）。创建时填入 Excel「基础信息」表的字段，初始价由公式自动算。
model Stock {
  id               Int       @id @default(autoincrement())
  code             String    // 股票代码
  name             String    // 公司名称
  // —— 创建股票时填入的基础信息（Excel「基础信息」表前 8 列）——
  totalShares      Float     // 总股本（万股）
  initNetProfit    Float     // 初始净利润（万）
  industryPE       Float     // 行业 PE
  currentCarbon    Float     // 当前碳排（未绑定区域总览字段时使用；绑定后由字段实时值覆盖）
  industryAvgCarbon Float    // 行业碳排均值
  happiness        Float     // 当前幸福度（未绑定区域总览字段时使用；绑定后由字段实时值覆盖）
  // —— 绑定区域总览卡片（实时引用）：JSON {region, cardId}，null/空 = 未绑定，使用上面的手动值 ——
  carbonFieldRef    String?  // 当前碳排绑定的区域总览卡片引用
  happinessFieldRef String?  // 当前幸福度绑定的区域总览卡片引用
  industryAvgCarbonRefs String? // 行业碳排均值绑定的区域总览卡片引用数组 JSON [{region,cardId},...]，null/空=未绑定（用手动值）
  // —— 行业 PE 动态化 ——
  // industryPE 既是初始价公式的除数，也作为「有效 PE 缓存」：联动/随机得到的有效 PE 写入此列。
  // 联动模式：pbCompanyId + pbFieldId 同时非空，PE 取该公司产业字段实时值。
  // 随机模式：pbCompanyId 为空，PE 取自 pbRandom（0~20，每轮 ±2 游走）。
  pbCompanyId      Int?      // PE 联动来源公司（null = 随机源模式）
  pbFieldId        Int?      // 绑定的该公司产业字段 id（联动模式有效）
  pbRandom         Float?    // 随机源当前值（0~20，随机模式有效）
  // —— 派生 / 运行时字段 ——
  initPrice        Float     // 初始价 = ROUND(initNetProfit*10000/totalShares/industryPE, 2)
  currentPrice     Float     // 当前价（最新收盘价），初始 = initPrice
  round            Int       @default(0) // 已完成轮次（已生成的 K 线数）
  companyId        Int?      // 关联商赛公司（可选，用于低级管理范围匹配与展示）
  company          Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  competitionId    Int?
  competition      Competition? @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  orders           StockOrder[]
  holdings         StockHolding[]
  candles          StockCandle[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([competitionId, code])
}

// 资金账户：现金账户，用于买卖任意股票。ownerType=COMPANY 时归属某公司，=USER 时归属某用户。
model StockFundsAccount {
  id            Int       @id @default(autoincrement())
  name          String    // 资金账户名（比赛内唯一）
  ownerType     String    // COMPANY | USER
  companyId     Int?      // ownerType=COMPANY 时指向 Company.id（低级管理范围据此限定）
  userId        Int?      // ownerType=USER 时指向 User.id（自己的账户）
  cashBalance   Float     @default(1000000) // 现金余额（元）
  bindFieldId   Int?      // 绑定产业字段 ID（仅公司账户），现金将同步该字段值
  competitionId Int?
  competition   Competition? @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  orders        StockOrder[]
  holdings       StockHolding[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([competitionId, name])
}

// 持仓：某资金账户持有某股票的数量与成本价。
model StockHolding {
  id            Int       @id @default(autoincrement())
  fundsAccountId Int
  stockId       Int
  shares        Float     // 持股数量（股）
  costPrice     Float     // 成本价（元/股）
  fundsAccount  StockFundsAccount @relation(fields: [fundsAccountId], references: [id], onDelete: Cascade)
  stock         Stock     @relation(fields: [stockId], references: [id], onDelete: Cascade)
  competitionId Int?
  competition   Competition? @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([fundsAccountId, stockId])
}

// 订单：玩家在某轮对某股票下的买卖委托。PENDING 在「下一轮」撮合后变 FILLED / CANCELLED。
model StockOrder {
  id            Int       @id @default(autoincrement())
  stockId       Int
  fundsAccountId Int
  side          String    // BUY | SELL
  price         Float     // 委托价（元/股）
  quantity      Float     // 委托数量（股）
  amount        Float     // 金额 = price * quantity
  status        String    @default("PENDING") // PENDING | FILLED | CANCELLED
  round         Int       @default(0) // 下单所属轮次
  fundsAccount  StockFundsAccount @relation(fields: [fundsAccountId], references: [id], onDelete: Cascade)
  stock         Stock     @relation(fields: [stockId], references: [id], onDelete: Cascade)
  competitionId Int?
  competition   Competition? @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([competitionId, stockId, round, status])
}

// K 线：每轮每股票一根。close = 本轮最终价（限幅 ±10% 后的理论价）。
model StockCandle {
  id            Int       @id @default(autoincrement())
  stockId       Int
  round         Int       // 轮次（第几根 K 线，从 1 开始）
  open          Float
  high          Float
  low           Float
  close         Float
  changePct     Float     // 涨跌幅 % = (close-open)/open*100
  stock         Stock     @relation(fields: [stockId], references: [id], onDelete: Cascade)
  competitionId Int?
  competition   Competition? @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([stockId, round])
}
